# Copy this file to .env and fill the values
# Vite requires env vars prefixed with VITE_

# Pour obtenir ces valeurs, créez un compte sur https://www.emailjs.com/
# 1. Créez un service email (Gmail, Outlook, etc.)
# 2. Créez un template avec les variables: from_name, from_email, message, to_email
# 3. Obtenez votre Public Key dans Account > General

VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY

# Optionnel — template copie client (sinon = VITE_EMAILJS_TEMPLATE_ID)
# Le champ To Email du template doit être : {{to_email}}
# VITE_EMAILJS_CLIENT_TEMPLATE_ID=template_client_xxx

# Email de réception des devis (prestataire)
# VITE_OWNER_EMAIL=bendelothielcy@gmail.com

# Example (format moderne — Public Key SANS préfixe user_) :
# VITE_EMAILJS_SERVICE_ID=service_abc123
# VITE_EMAILJS_TEMPLATE_ID=template_xyz789
# VITE_EMAILJS_PUBLIC_KEY=AbCdEfGhIjKlMnOpQ
#
# Où trouver la Public Key :
# https://dashboard.emailjs.com/admin/account
#
# Variables utiles dans le template devis :
# {{to_email}} {{reply_to}} {{subject}} {{quote_ref}} {{client_name}}
# {{client_email}} {{phone}} {{company}} {{project_type}} {{budget}}
# {{timeline}} {{message}} {{files_list}} {{submission_date}} {{email_title}}
#
# Pièces jointes PDF : activées via API si ton plan EmailJS le permet.
# Sinon le PDF est quand même téléchargé dans le navigateur du client.

# Note: Si ces valeurs ne sont pas configurées, le formulaire utilisera
# automatiquement le mailto: comme solution de secours.
